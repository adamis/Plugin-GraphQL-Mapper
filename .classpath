<?xml version="1.0" encoding="UTF-8"?>
<classpath>
	<classpathentry kind="con" path="org.eclipse.jdt.launching.JRE_CONTAINER">
		<attributes>
			<attribute name="maven.pomderived" value="true"/>
		</attributes>
	</classpathentry>
	<classpathentry kind="con" path="org.eclipse.pde.core.requiredPlugins"/>
	<classpathentry kind="src" output="bin" path="src">
		<attributes>
			<attribute name="optional" value="true"/>
			<attribute name="maven.pomderived" value="true"/>
		</attributes>
	</classpathentry>
	<classpathentry exported="true" kind="lib" path="lib/sqlite-jdbc-3.43.0.0.jar"/>
	<classpathentry exported="true" kind="lib" path="lib/okhttp-4.12.0.jar"/>
	<classpathentry exported="true" kind="lib" path="lib/okio-jvm-3.6.0.jar"/>
	<classpathentry exported="true" kind="lib" path="lib/kotlin-stdlib-1.9.10.jar"/>
	<classpathentry exported="true" kind="lib" path="lib/jackson-databind-2.18.0.jar"/>
	<classpathentry exported="true" kind="lib" path="lib/jackson-core-2.18.0.jar"/>
	<classpathentry exported="true" kind="lib" path="lib/jackson-annotations-2.18.0.jar"/>
	<classpathentry exported="true" kind="lib" path="lib/json-20240303.jar"/>
	<classpathentry exported="true" kind="lib" path="lib/logging-interceptor-4.12.0.jar"/>
	<classpathentry kind="con" path="org.eclipse.m2e.MAVEN2_CLASSPATH_CONTAINER">
		<attributes>
			<attribute name="maven.pomderived" value="true"/>
		</attributes>
	</classpathentry>
	<classpathentry kind="output" path="bin"/>
</classpath>
